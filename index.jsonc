{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_args",

  // 1-2 sentence summary about this repo.
  "summary": "Helpers on top of package:args for the gg command line tools.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "DirCommand: command running on a directory, with mocks",
    "GgCommandRunner; missing and unknown sub commands",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_log": "GgLog",
      "gg_process": "GgProcessWrapper",
      "gg_console_colors": "colored output",
      "gg_capture_print": "capturePrint in missingSubCommands",
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "GgCommandRunner",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg": "GgCommandRunner",
      "gg_changelog": "DirCommand, GgCommandRunner, MockDirCommand",
      "gg_clone_dependencies": "DirCommand, GgCommandRunner",
      "gg_create_package": "GgCommandRunner",
      "gg_create_repo": "GgCommandRunner",
      "gg_git": "DirCommand, GgCommandRunner, MockDirCommand",
      "gg_image_tools": "tests only",
      "gg_local_package_dependencies": "DirCommand, GgCommandRunner",
      "gg_localize_refs": "DirCommand, GgCommandRunner, MockDirCommand",
      "gg_merge": "DirCommand, GgCommandRunner, MockDirCommand",
      "gg_multi": "GgCommandRunner",
      "gg_multi_commit": "DirCommand, MockDirCommand",
      "gg_multi_core": "MockDirCommand",
      "gg_multi_do_publish": "DirCommand, MockDirCommand",
      "gg_multi_maintain": "GgCommandRunner",
      "gg_multi_workspace": "DirCommand, MockDirCommand",
      "gg_one": "GgCommandRunner",
      "gg_one_commit": "DirCommand, MockDirCommand",
      "gg_one_core": "DirCommand, MockDirCommand",
      "gg_one_do_publish": "DirCommand, MockDirCommand",
      "gg_one_merge": "MockDirCommand",
      "gg_parse_stdout": "tests only",
      "gg_project_root": "GgCommandRunner",
      "gg_publish": "DirCommand, GgCommandRunner, MockDirCommand",
      "gg_test": "DirCommand, GgCommandRunner",
      "gg_version": "DirCommand, GgCommandRunner",
      "helix": "GgCommandRunner",
      "kidney_ui": "GgCommandRunner",
      "gg_bridge_dart_side": "GgCommandRunner",
    },
  },
}
